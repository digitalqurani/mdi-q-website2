{
  "name": "mdi-q-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "npm install next@14.2.15 react@18.3.1 react-dom@18.3.1 tailwindcss@3.4.13 postcss@8.4.39 autoprefixer@10.4.20 framer-motion react-icons prettier eslint eslint-config-next eslint-config-prettier eslint-plugin-prettier husky lint-staged",
    "format": "prettier --write .",
    "lint": "next lint",
    "prepare": "husky install"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "framer-motion": "^11.18.2",
    "next": "^14.2.15",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^8.0.3",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2"
  },
  "prettier": {
    "semi": false,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
